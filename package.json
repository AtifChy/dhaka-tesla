{
  "name": "dhaka-tesla-pool",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "composer:deploy": "prisma deploy module.ts",
    "composer:dev": "prisma dev module.ts",
    "contract:emit": "prisma contract emit",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "db:seed": "bun scripts/seed.ts",
    "deploy": "bun run build && bun run composer:deploy",
    "dev": "bun --watch src/main.ts",
    "dev:composer": "bun run build && bun run composer:dev",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "skills:sync": "prisma skills sync || exit 0",
    "start": "node dist/server.mjs",
    "postinstall": "prisma skills sync || exit 0",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint src/ text/",
    "lint:fix": "oxlint src/ text/ --fix"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "@prisma/composer": "0.23.0",
    "@prisma/composer-prisma-cloud": "0.23.0",
    "@prisma/orm-postgres": "8.0.0-rc.12",
    "alchemy": "2.0.0-beta.79",
    "argon2": "^0.45.1",
    "nestjs-zod": "^5.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "temporal-polyfill": "^1.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prisma/dev": "0.25.2",
    "@types/node": "^26.6.3",
    "@types/passport-jwt": "^4.0.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prisma": "8.0.0-rc.17",
    "tsdown": "^0.23.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "effect": "4.0.0-rc.112"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "bun@1.4.1"
}
